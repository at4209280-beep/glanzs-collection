* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, sans-serif;
  color: #171717;
  background: #fff;
}

header {
  min-height: 85px;
  padding: 24px 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #eee;
}

.logo {
  color: #111;
  text-decoration: none;
  font-size: 19px;
  font-weight: 700;
  letter-spacing: 3px;
}

nav {
  display: flex;
  gap: 28px;
}

nav a {
  color: #333;
  text-decoration: none;
  font-size: 13px;
}

nav a:hover {
  color: #999;
}

.hero {
  min-height: 570px;
  padding: 100px 20px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  background: #f7f6f3;
}

.hero p:first-child,
.eyebrow {
  font-size: 11px;
  letter-spacing: 4px;
  color: #777;
}

.hero h1 {
  margin: 25px 0;
  font-family: Georgia, serif;
  font-size: clamp(38px, 6vw, 68px);
  font-weight: 400;
}

.hero p {
  line-height: 1.8;
}

.button {
  display: inline-block;
  margin-top: 30px;
  padding: 16px 30px;
  background: #171717;
  color: white;
  text-decoration: none;
  font-size: 12px;
  letter-spacing: 1px;
}

.button:hover {
  background: #444;
}

.products {
  padding: 100px 7%;
  text-align: center;
}

h2 {
  margin: 18px 0 45px;
  font-family: Georgia, serif;
  font-size: 38px;
  font-weight: 400;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
  text-align: left;
}

.product-image {
  height: 320px;
  background: #f0efec;
  margin-bottom: 22px;
}

.image-two {
  background: #e7e4df;
}

.image-three {
  background: #eeece8;
}

.grid h3 {
  font-family: Georgia, serif;
  font-size: 20px;
  font-weight: 400;
}

.grid article p {
  margin-top: 10px;
  color: #777;
  font-size: 13px;
}

.about,
.contact {
  padding: 90px 20px;
  text-align: center;
  background: #f7f6f3;
}

.about h2,
.contact h2 {
  margin-bottom: 20px;
}

.about > p:last-child,
.contact p {
  max-width: 550px;
  margin: auto;
  line-height: 1.8;
  color: #666;
}

.contact {
  background: white;
}

footer {
  padding: 30px;
  text-align: center;
  border-top: 1px solid #eee;
  font-size: 11px;
  letter-spacing: 2px;
}

@media (max-width: 700px) {
  header {
    flex-direction: column;
    gap: 20px;
  }

  nav {
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
  }

  .grid {
    grid-template-columns: 1fr;
  }

  .product-image {
    height: 350px;
  }

  .products {
    padding: 65px 6%;
  }
}
