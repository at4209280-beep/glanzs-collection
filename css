
* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  font-family: Arial, sans-serif;
  color: #222;
  background: white;
  line-height: 1.6;
}

.header {
  padding: 24px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #eee;
}

.logo {
  font-size: 18px;
  font-weight: bold;
  letter-spacing: 2px;
}

nav { display: flex; gap: 24px; }

a { color: inherit; text-decoration: none; }

nav a:hover { color: #999; }

#menuButton { display: none; }

.hero {
  text-align: center;
  padding: 120px 20px;
  background: #f8f7f5;
}

.hero h1 {
  font-family: Georgia, serif;
  font-size: clamp(40px, 6vw, 72px);
  font-weight: normal;
}

.hero p { color: #666; }

.button {
  display: inline-block;
  background: #222;
  color: white;
  padding: 13px 24px;
  margin-top: 15px;
}

.button:hover { background: #555; }

.section {
  padding: 75px 7%;
  text-align: center;
}

.section h2 {
  font-family: Georgia, serif;
  font-size: 36px;
  font-weight: normal;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
  text-align: left;
}

.product img {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

.product p, .about p { color: #777; }

.about { background: #f8f7f5; }

footer {
  padding: 25px;
  border-top: 1px solid #eee;
  text-align: center;
}

@media (max-width: 700px) {
  .header { flex-wrap: wrap; }
  #menuButton { display: block; }
  nav { display: none; width: 100%; flex-direction: column; padding-top: 20px; }
  nav.open { display: flex; }
  .product-grid { grid-template-columns: 1fr; }
  .hero { padding: 80px 20px; }
}
